{
  "name": "@iomtea/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "db:generate": "tsx node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "tsx node_modules/drizzle-kit/bin.cjs push",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-openapi": "^1.4.0",
    "@iomtea/shared-types": "workspace:*",
    "@msgpack/msgpack": "^3.1.3",
    "@node-rs/argon2": "^2.0.0",
    "@scalar/api-reference": "^1.57.5",
    "@scalar/hono-api-reference": "^0.10.19",
    "casbin": "^5.50.0",
    "casbin-pg-adapter": "^1.4.0",
    "cron-parser": "^5.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "mqtt": "^5.10.0",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "uuid": "^11.0.0",
    "ws": "^8.20.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
