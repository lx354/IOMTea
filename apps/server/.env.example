# ============================================
# IOMTea Server 环境配置（同根目录 .env，仅作参考）
# 不需要单独配置此文件
# ============================================

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/iomtea
JWT_SECRET=change-me-to-a-random-string-at-least-16-chars
CORS_ORIGIN=http://localhost:5173
MQTT_ENABLED=false
