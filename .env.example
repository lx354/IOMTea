# ============================================
# IOMTea 环境配置
# 复制此文件为 .env，修改后启动
# cp .env.example .env
# ============================================

# ---- 数据库连接（PostgreSQL） ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/iomtea

# ---- JWT 密钥（随便打一串字符，至少 16 位） ----
JWT_SECRET=change-me-to-a-random-string-at-least-16-chars

# ---- Web 前端地址（CORS） ----
CORS_ORIGIN=http://localhost:5173

# ---- MQTT 设备接入（树莓派等硬件用到时才开启） ----
MQTT_ENABLED=false
